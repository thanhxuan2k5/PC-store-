# Cấu hình bảo mật JWT Token
SECRET_KEY=gearvn_super_secret_jwt_key_2026_production_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cấu hình Database
DATABASE_URL=sqlite:///./data/gearvn.db

# Cấu hình AI Assistant & LLM Studio
USE_LOCAL_LLM=true
# Nếu chạy qua Docker: dùng host.docker.internal; nếu chạy local ngoài: dùng localhost
LM_STUDIO_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct
LM_STUDIO_API_KEY=
LM_STUDIO_ENABLED=true
LM_STUDIO_TIMEOUT=30
AI_MAX_TOKENS=400

# TypeSafe AI Jev Decision Engine
TYPESAFE_AI_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-decision-v1
JEV_ENABLED=true
JEV_TIMEOUT=10
